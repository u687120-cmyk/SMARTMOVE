# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartmove_ai
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Weather Provider Configuration (Phase 14)
# Open-Meteo provides public meteorological data by default.
# Optional API key for proprietary providers (e.g. OpenWeatherMap):
WEATHER_API_KEY=

# Traffic Provider Configuration (Phase 15)
# Uses clean TrafficProvider abstraction with deterministic simulation by default.
# Optional API key for commercial traffic providers (e.g. TomTom, Here, Google):
TRAFFIC_API_KEY=


